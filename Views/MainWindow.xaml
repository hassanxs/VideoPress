<Window x:Class="VideoPress.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VideoPress.ViewModels"
        xmlns:conv="clr-namespace:VideoPress.Converters"
        xmlns:models="clr-namespace:VideoPress.Models"
        Title="VideoPress — Compression Studio"
        Height="780" Width="1180" MinWidth="960" MinHeight="600"
        Background="{DynamicResource BgBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True">

  <Window.DataContext>
    <vm:MainViewModel/>
  </Window.DataContext>

  <Window.Resources>
    <conv:FileStatusToColorConverter   x:Key="StatusColor"/>
    <conv:FileStatusToBorderConverter  x:Key="StatusBorder"/>
    <conv:FileStatusToProgressVis      x:Key="StatusProgressVis"/>
    <conv:BoolToVisibilityConverter    x:Key="BoolToVis"/>
    <conv:BoolToVisibilityConverter    x:Key="InvBoolToVis" Invert="True"/>
    <conv:EnumToBoolConverter          x:Key="EnumToBool"/>
    <conv:LongToVisibilityConverter    x:Key="LongToVis"/>
    <conv:QualityModeVisConverter      x:Key="CRFVis"     TargetMode="CRF"/>
    <conv:QualityModeVisConverter      x:Key="BitrateVis" TargetMode="Bitrate"/>
    <conv:QualityModeVisConverter      x:Key="SizeVis"    TargetMode="TargetSize"/>
    <conv:ResModeVisConverter          x:Key="ResPresetVis" TargetMode="Preset"/>
    <conv:ResModeVisConverter          x:Key="ResCustomVis" TargetMode="Custom"/>
    <conv:SavingsTextColorConverter    x:Key="SavingsColor"/>
    <conv:StringToVisibilityConverter  x:Key="StringToVis"/>
    <conv:IntToVisibilityConverter     x:Key="IntToVis"/>
    <conv:NullToVisConverter           x:Key="NullToVisVis"  Invert="False"/>
    <conv:NullToVisConverter           x:Key="NullToColVis"  Invert="True"/>
    <conv:GpuVendorToColorConverter    x:Key="GpuColor"/>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- ══ HEADER ══ -->
    <Border Grid.Row="0" Background="{DynamicResource Bg2Brush}"
            BorderBrush="{DynamicResource Border2Brush}" BorderThickness="0,0,0,1">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
          <Border Background="{DynamicResource AccentBrush}" CornerRadius="6"
                  Width="28" Height="28" Margin="0,0,9,0">
            <TextBlock Text="▶" Foreground="White" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="Bold"
                     Foreground="{DynamicResource TextBrush}">
            <Run Text="Video"/>
            <Run Text="Press" Foreground="{DynamicResource AccentLightBrush}"/>
          </TextBlock>
        </StackPanel>

        <!-- Center column intentionally empty — pills moved to right -->
        <StackPanel Grid.Column="1"/>

        <!-- Right buttons -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

          <!-- FFmpeg status pill — gradient border capsule -->
          <Border CornerRadius="20" Margin="0,0,8,0"
                  Background="{DynamicResource NeonGreenGradient}" Padding="2">
            <Border CornerRadius="18" Padding="10,5"
                    Background="{DynamicResource BgBrush}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                         Fill="{DynamicResource NeonGreenDot}"/>
                <TextBlock Text="{Binding FfmpegStatus}" FontFamily="{DynamicResource MonoFont}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource NeonGreenText}" VerticalAlignment="Center"/>
                <ProgressBar Value="{Binding ExtractProgress}" Width="80" Height="4" Margin="8,0,0,0"
                             Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVis}}"/>
              </StackPanel>
            </Border>
          </Border>

          <!-- GPU badge pill — gradient border capsule -->
          <Border CornerRadius="20" Margin="0,0,10,0"
                  Background="{DynamicResource NeonBlueGradient}" Padding="2">
            <Border CornerRadius="18" Padding="10,5"
                    Background="{DynamicResource BgBrush}">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="6" Height="6" Margin="0,0,7,0" VerticalAlignment="Center"
                         Fill="{DynamicResource NeonBlueDot}"/>
                <TextBlock Text="{Binding Gpu.DisplayName}" FontFamily="{DynamicResource MonoFont}"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource NeonBlueText}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Border>

          <!-- Theme picker button + popup -->
          <Grid Margin="0,0,6,0">
            <Button x:Name="ThemeBtn" Style="{DynamicResource GhostButton}"
                    Click="ThemeBtn_Click">
              <StackPanel Orientation="Horizontal">
                <!-- Icon changes with theme -->
                <TextBlock VerticalAlignment="Center" Margin="0,0,5,0">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="🌙"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ThemeChoice}" Value="Light">
                          <Setter Property="Text" Value="☀"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ThemeChoice}" Value="Auto">
                          <Setter Property="Text" Value="⊙"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding ThemeChoice}" VerticalAlignment="Center"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11"/>
              </StackPanel>
            </Button>
            <!-- Dropdown popup -->
            <Popup x:Name="ThemePopup" PlacementTarget="{Binding ElementName=ThemeBtn}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
              <Border Background="{DynamicResource Bg2Brush}"
                      BorderBrush="{DynamicResource Border2Brush}"
                      BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                      Padding="4" MinWidth="140">
                <StackPanel>
                  <!-- Dark option -->
                  <Border CornerRadius="5" Cursor="Hand" Margin="0,0,0,1"
                          Tag="Dark" MouseLeftButtonUp="ThemeOption_Click">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Bg4Brush}"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding ThemeChoice}" Value="Dark">
                            <Setter Property="Background" Value="{DynamicResource AccentBgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" Margin="10,8">
                      <TextBlock Text="🌙" Margin="0,0,8,0"
                                 Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="Dark" FontSize="12"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>
                  <!-- Light option -->
                  <Border CornerRadius="5" Cursor="Hand" Margin="0,0,0,1"
                          Tag="Light" MouseLeftButtonUp="ThemeOption_Click">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Bg4Brush}"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding ThemeChoice}" Value="Light">
                            <Setter Property="Background" Value="{DynamicResource AccentBgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" Margin="10,8">
                      <TextBlock Text="☀" Margin="0,0,8,0"
                                 Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="Light" FontSize="12"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>
                  <!-- Divider -->
                  <Border Height="1" Background="{DynamicResource Border2Brush}" Margin="6,3"/>
                  <!-- Auto option -->
                  <Border CornerRadius="5" Cursor="Hand"
                          Tag="Auto" MouseLeftButtonUp="ThemeOption_Click">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource Bg4Brush}"/>
                          </Trigger>
                          <DataTrigger Binding="{Binding ThemeChoice}" Value="Auto">
                            <Setter Property="Background" Value="{DynamicResource AccentBgBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal" Margin="10,8">
                      <TextBlock Text="⊙" Margin="0,0,8,0"
                                 Foreground="{DynamicResource TextBrush}"/>
                      <TextBlock Text="Follow System" FontSize="12"
                                 Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </Popup>
          </Grid>

          <Button Content="⚙ Presets" Style="{DynamicResource GhostButton}" Margin="0,0,6,0"
                  Command="{Binding TogglePresetsPanelCommand}"/>
          <Button Content="📋 Log" Style="{DynamicResource GhostButton}"
                  Command="{Binding ToggleLogCommand}"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══ ACTIVE PRESET BAR (shown when a preset is applied) ══ -->
    <Border Grid.Row="1" Background="{DynamicResource AccentBgBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1"
            Padding="20,7"
            Visibility="{Binding ActivePresetName, Converter={StaticResource StringToVis}}">

      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="⚙" Foreground="{DynamicResource AccentLightBrush}"
                     FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center"/>
          <TextBlock Foreground="{DynamicResource AccentLightBrush}" FontSize="12"
                     FontWeight="SemiBold" VerticalAlignment="Center"
                     Text="{Binding ActivePresetName}"/>
          <TextBlock Foreground="{DynamicResource Text3Brush}" FontSize="12"
                     VerticalAlignment="Center" Margin="6,0,0,0" Text="(modified)"
                     Visibility="{Binding PresetModified, Converter={StaticResource BoolToVis}}"/>
          <TextBlock Foreground="{DynamicResource Text3Brush}" FontSize="12"
                     VerticalAlignment="Center" Margin="6,0,0,0" Text="preset active"/>
        </StackPanel>
        <!-- Reset to defaults button — right-aligned -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                Style="{DynamicResource GhostButton}" Padding="8,3"
                Command="{Binding ResetToDefaultsCommand}"
                ToolTip="Reset all settings to defaults (H.264 · CRF 23 · Original res · AAC 128k)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="↺ " FontSize="11" Foreground="{DynamicResource Text3Brush}"/>
            <TextBlock Text="reset to defaults" FontSize="10" Foreground="{DynamicResource Text3Brush}"
                       FontFamily="{DynamicResource MonoFont}"/>
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ══ EXTRACTION OVERLAY (first run only, ~1 second) ══ -->
    <Border Grid.Row="1" Background="{DynamicResource AccentBgBrush}"
            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0,0,0,1" Padding="20,10"
            Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVis}}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="⚙" Foreground="{DynamicResource AccentLightBrush}" FontSize="13"
                   Margin="0,0,10,0" VerticalAlignment="Center"/>
        <TextBlock Foreground="{DynamicResource AccentLightBrush}" FontSize="12"
                   VerticalAlignment="Center" Text="{Binding ExtractMessage}"/>
      </StackPanel>
    </Border>

    <!-- ══ MAIN ══ -->
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="320"/>
      </Grid.ColumnDefinitions>

      <!-- ── LEFT PANEL ── -->
      <Grid Grid.Column="0" Margin="20,16,10,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Drop zone -->
        <Border Grid.Row="0" x:Name="DropBorder"
                BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1.5"
                CornerRadius="10" Padding="0,26" Background="{DynamicResource Bg2Brush}"
                Cursor="Hand" Margin="0,0,0,14"
                MouseLeftButtonUp="DropBorder_Click">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                  <Setter Property="Background" Value="{DynamicResource AccentBgBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center">
            <TextBlock Text="⬡" FontSize="30" Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,9"/>
            <TextBlock Text="Drop video files here" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" Margin="0,0,0,5"/>
            <TextBlock Text="MP4  MOV  MKV  AVI  WebM — drag multiple files at once"
                       FontFamily="{DynamicResource MonoFont}" FontSize="11"
                       Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,0,0,14"/>
            <Button Content="Browse files…" Style="{DynamicResource SecondaryButton}"
                    Padding="16,7" HorizontalAlignment="Center"
                    Click="BrowseFiles_Click"/>
          </StackPanel>
        </Border>

        <!-- Queue header -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="QUEUE" Style="{DynamicResource SectionLabel}" Margin="0" VerticalAlignment="Center"/>
            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8"
                    Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0">
              <TextBlock Text="{Binding Files.Count}" FontFamily="{DynamicResource MonoFont}"
                         FontSize="11" Foreground="{DynamicResource AccentLightBrush}"/>
            </Border>
          </StackPanel>
          <Button Grid.Column="1" Content="Clear done" Style="{DynamicResource GhostButton}"
                  Command="{Binding ClearQueueCommand}"/>
        </Grid>

        <!-- File list -->
        <Grid Grid.Row="2">
          <!-- Empty state -->
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                     Text="No files added yet.&#x0a;Drop a video above or click Browse."
                     FontFamily="{DynamicResource MonoFont}" FontSize="12"
                     Foreground="{DynamicResource Text3Brush}" TextAlignment="Center" LineHeight="22"
                     Visibility="{Binding HasFiles, Converter={StaticResource InvBoolToVis}}"/>

          <ListBox x:Name="FileListBox"
                   ItemsSource="{Binding Files}"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   Background="Transparent" BorderThickness="0"
                   Visibility="{Binding HasFiles, Converter={StaticResource BoolToVis}}"
                   AllowDrop="True"
                   PreviewMouseLeftButtonDown="FileList_MouseDown"
                   PreviewMouseMove="FileList_MouseMove"
                   Drop="FileList_Drop"
                   DragOver="FileList_DragOver">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <ContentPresenter/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                  <Border Margin="0,0,0,7" CornerRadius="9" Padding="12,11"
                          Background="{DynamicResource Bg3Brush}"
                          BorderThickness="1"
                          BorderBrush="{Binding Status, Converter={StaticResource StatusBorder}}">
                    <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="26"/>
                      </Grid.ColumnDefinitions>

                      <!-- Drag handle -->
                      <TextBlock Grid.Column="0" Text="⠿" FontSize="14"
                                 Foreground="{DynamicResource Text3Brush}"
                                 VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Cursor="SizeAll" Margin="0,0,4,0"
                                 ToolTip="Drag to reorder"/>

                      <!-- Ext badge -->
                      <Border Grid.Column="1" Background="{DynamicResource Bg4Brush}"
                              BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
                              CornerRadius="6" Width="38" Height="38" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Ext}" FontFamily="{DynamicResource MonoFont}"
                                   FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentLightBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>

                      <!-- Info -->
                      <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>

                        <!-- Size row: original → output + savings (shown when done) -->
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0"
                                    Visibility="{Binding OutputSize, Converter={StaticResource LongToVis}}">
                          <TextBlock Text="{Binding OriginalSizeStr}"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource Text3Brush}"/>
                          <TextBlock Text=" → "
                                     FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource Text3Brush}"/>
                          <TextBlock Text="{Binding OutputSizeStr}"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{Binding SavingsText, Converter={StaticResource SavingsColor}}"/>
                          <TextBlock Text="{Binding SavingsText}" Margin="6,0,0,0"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{Binding SavingsText, Converter={StaticResource SavingsColor}}"/>
                        </StackPanel>

                        <!-- Static size row when not yet compressed -->
                        <TextBlock Margin="0,3,0,0"
                                   FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                   Foreground="{DynamicResource Text3Brush}"
                                   Text="{Binding OriginalSizeStr}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding OutputSize, Converter={StaticResource LongToVis}}"
                                             Value="Visible">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasStats}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>

                        <!-- Live stats row (only while Running and HasStats) -->
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0"
                                    Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                          <!-- Speed -->
                          <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource AccentLightBrush}"
                                     Text="{Binding Speed}" Margin="0,0,0,0"
                                     Visibility="{Binding Speed, Converter={StaticResource StringToVis}}"/>
                          <!-- Separator -->
                          <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource Text3Brush}" Text=" · "
                                     Visibility="{Binding Speed, Converter={StaticResource StringToVis}}"/>
                          <!-- Bitrate -->
                          <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource Text2Brush}"
                                     Text="{Binding Bitrate}"
                                     Visibility="{Binding Bitrate, Converter={StaticResource StringToVis}}"/>
                          <!-- Separator -->
                          <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource Text3Brush}" Text=" · "
                                     Visibility="{Binding Eta, Converter={StaticResource StringToVis}}"/>
                          <!-- ETA -->
                          <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource Text3Brush}" Text="ETA "
                                     Visibility="{Binding Eta, Converter={StaticResource StringToVis}}"/>
                          <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource TextBrush}"
                                     Text="{Binding Eta}"
                                     Visibility="{Binding Eta, Converter={StaticResource StringToVis}}"/>
                        </StackPanel>
                      </StackPanel>

                      <!-- Progress bar (only while running) -->
                      <ProgressBar Grid.Column="3" Height="4" VerticalAlignment="Center" Margin="8,0"
                                   Value="{Binding Progress}" Maximum="100"
                                   Visibility="{Binding Status, Converter={StaticResource StatusProgressVis}}"/>

                      <!-- Status pill + compare button -->
                      <StackPanel Grid.Column="4" Orientation="Horizontal"
                                  VerticalAlignment="Center" Margin="0,0,6,0">
                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,5,0"
                                Background="{Binding Status, Converter={StaticResource StatusBorder}}">
                          <TextBlock Text="{Binding StatusText}"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{Binding Status, Converter={StaticResource StatusColor}}"/>
                        </Border>
                        <Border CornerRadius="4" Padding="6,3" Cursor="Hand"
                                Background="{DynamicResource AccentBgBrush}"
                                MouseLeftButtonUp="CompareBtn_Click"
                                ToolTip="Before / After comparison">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <MultiDataTrigger>
                                  <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Status, Converter={StaticResource StatusProgressVis}}" Value="Collapsed"/>
                                    <Condition Binding="{Binding OutputSize, Converter={StaticResource LongToVis}}" Value="Visible"/>
                                  </MultiDataTrigger.Conditions>
                                  <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource AccentLightBrush}" Text="compare"/>
                        </Border>
                      </StackPanel>

                      <!-- Info button — expands card to show MediaInfo details -->
                      <Button Grid.Column="5" Content="ⓘ" Width="22" Height="22"
                              VerticalAlignment="Center" FontSize="13"
                              Foreground="{DynamicResource Text3Brush}"
                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                              ToolTip="Show file details"
                              Click="InfoBtn_Click"/>

                      <!-- Remove -->
                      <Button Grid.Column="6" Content="×" Width="22" Height="22"
                              VerticalAlignment="Center" FontSize="15"
                              Foreground="{DynamicResource Text3Brush}"
                              Background="Transparent" BorderThickness="0" Cursor="Hand"
                              Command="{Binding DataContext.RemoveFileCommand,
                                        RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"/>

                      <!-- Expand toggle (invisible hit area over info column) -->
                      <Border Grid.Column="2" Background="Transparent" Cursor="Hand"
                              ToolTip="Click to expand / collapse"
                              MouseLeftButtonUp="FileCard_ExpandToggle"/>
                    </Grid>

                    <!-- ══ Expanded metadata + thumbnail panel ══ -->
                    <Border Margin="0,10,0,0" Padding="0,10,0,0"
                            BorderBrush="{DynamicResource Border2Brush}" BorderThickness="0,1,0,0"
                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                      <StackPanel>

                        <!-- Row 1: Thumbnail + basic metadata -->
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>

                          <!-- Thumbnail -->
                          <Border Grid.Column="0" CornerRadius="5" ClipToBounds="True"
                                  Margin="0,0,14,0" Width="120" Height="68"
                                  Background="{DynamicResource Bg4Brush}">
                            <Grid>
                              <TextBlock Text="⬡" FontSize="22" HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{DynamicResource Text3Brush}"
                                         Visibility="{Binding Thumbnail, Converter={StaticResource NullToColVis}}"/>
                              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                     Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisVis}}"/>
                            </Grid>
                          </Border>

                          <!-- Basic metadata grid -->
                          <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Duration"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Duration}"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,12,5"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Resolution"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,5"/>
                            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,5">
                              <TextBlock Text="{Binding Resolution}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                         Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0"/>
                              <Border CornerRadius="3" Padding="5,1" Background="#C0A020"
                                      Visibility="{Binding IsHdr, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding HdrFormat}" FontFamily="{DynamicResource MonoFont}"
                                           FontSize="8" FontWeight="SemiBold" Foreground="White"/>
                              </Border>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Codec"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VideoProfile}"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,12,5"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="FPS"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,5"/>
                            <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,5">
                              <TextBlock Text="{Binding Fps}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                         Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0"/>
                              <TextBlock Text="{Binding FrameRateMode}"
                                         FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                         Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Bitrate"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VideoBitrate}"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,12,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Overall"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,0,8,0"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding OverallBitrate}"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource TextBrush}"/>
                          </Grid>
                        </Grid>

                        <!-- Row 2: Rich MediaInfo badge strip (visible once MediaInfo loaded) -->
                        <Border Margin="0,8,0,0" Padding="10,8"
                                Background="{DynamicResource Bg4Brush}" CornerRadius="6"
                                Visibility="{Binding MediaInfoLoaded, Converter={StaticResource BoolToVis}}">
                          <StackPanel>

                            <!-- Video property badges -->
                            <WrapPanel Margin="0,0,0,4">
                              <Border CornerRadius="3" Padding="6,2" Margin="0,0,5,4"
                                      Background="{DynamicResource Bg3Brush}"
                                      Visibility="{Binding BitDepth, Converter={StaticResource StringToVis}}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="Depth  " FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                                  <TextBlock Text="{Binding BitDepth}" FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                              </Border>
                              <Border CornerRadius="3" Padding="6,2" Margin="0,0,5,4"
                                      Background="{DynamicResource Bg3Brush}"
                                      Visibility="{Binding ChromaSubsampling, Converter={StaticResource StringToVis}}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="Chroma  " FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                                  <TextBlock Text="{Binding ChromaSubsampling}" FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                              </Border>
                              <Border CornerRadius="3" Padding="6,2" Margin="0,0,5,4"
                                      Background="{DynamicResource Bg3Brush}"
                                      Visibility="{Binding ColorRange, Converter={StaticResource StringToVis}}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="Range  " FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                                  <TextBlock Text="{Binding ColorRange}" FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                              </Border>
                              <Border CornerRadius="3" Padding="6,2" Margin="0,0,5,4"
                                      Background="{DynamicResource Bg3Brush}"
                                      Visibility="{Binding ColorPrimaries, Converter={StaticResource StringToVis}}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="Primaries  " FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                                  <TextBlock Text="{Binding ColorPrimaries}" FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                              </Border>
                              <Border CornerRadius="3" Padding="6,2" Margin="0,0,5,4"
                                      Background="{DynamicResource Bg3Brush}"
                                      Visibility="{Binding TransferChar, Converter={StaticResource StringToVis}}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="Transfer  " FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                                  <TextBlock Text="{Binding TransferChar}" FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                              </Border>
                              <Border CornerRadius="3" Padding="6,2" Margin="0,0,5,4"
                                      Background="{DynamicResource Bg3Brush}"
                                      Visibility="{Binding ScanType, Converter={StaticResource StringToVis}}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="Scan  " FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                                  <TextBlock Text="{Binding ScanType}" FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                              </Border>
                              <Border CornerRadius="3" Padding="6,2" Margin="0,0,5,4"
                                      Background="{DynamicResource Bg3Brush}"
                                      Visibility="{Binding AspectRatio, Converter={StaticResource StringToVis}}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="AR  " FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                                  <TextBlock Text="{Binding AspectRatio}" FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                              </Border>
                              <Border CornerRadius="3" Padding="6,2" Margin="0,0,0,4"
                                      Background="{DynamicResource Bg3Brush}"
                                      Visibility="{Binding Container, Converter={StaticResource StringToVis}}">
                                <StackPanel Orientation="Horizontal">
                                  <TextBlock Text="Container  " FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                                  <TextBlock Text="{Binding Container}" FontFamily="{DynamicResource MonoFont}"
                                             FontSize="9" Foreground="{DynamicResource TextBrush}"/>
                                </StackPanel>
                              </Border>
                            </WrapPanel>

                            <!-- Audio track badges -->
                            <ItemsControl ItemsSource="{Binding AudioTracks}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border CornerRadius="3" Padding="6,2" Margin="0,0,5,4"
                                          Background="{DynamicResource Bg3Brush}">
                                    <StackPanel Orientation="Horizontal">
                                      <TextBlock Text="🔊 " FontSize="9" VerticalAlignment="Center"/>
                                      <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                                 FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                                 Foreground="{DynamicResource TextBrush}"/>
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Encoder / writing app -->
                            <TextBlock Text="{Binding WritingApp}"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="9"
                                       Foreground="{DynamicResource Text3Brush}" Margin="0,4,0,0"/>
                          </StackPanel>
                        </Border>

                      </StackPanel>
                    </Border>

                    </StackPanel>
                  </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>

        <!-- Output folder -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Output:" FontSize="12" Foreground="{DynamicResource Text2Brush}"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}"
                   FontSize="11" Padding="7,6"/>
          <Button Grid.Column="2" Content="📁" Style="{DynamicResource SecondaryButton}"
                  Margin="6,0,0,0" Padding="10,6"
                  Command="{Binding BrowseOutputFolderCommand}"/>
        </Grid>

        <!-- Action bar -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Style="{DynamicResource PrimaryButton}" FontSize="14"
                  Command="{Binding CompressAllCommand}" Padding="0,12">
            <TextBlock Text="Compress all  →" VerticalAlignment="Center"/>
          </Button>
          <Button Grid.Column="1" Content="✕  Cancel" Style="{DynamicResource DangerButton}"
                  Margin="8,0,0,0" Padding="14,12"
                  Command="{Binding CancelCommand}"
                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
        </Grid>
      </Grid>

      <!-- ── RIGHT PANEL: Settings ── -->
      <Border Grid.Column="1" Background="{DynamicResource Bg2Brush}"
              BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1,0,0,0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="18,16">

            <!-- Codec -->
            <TextBlock Text="VIDEO CODEC" Style="{DynamicResource SectionLabel}"/>
            <UniformGrid Columns="2" Margin="0,0,0,16">
              <RadioButton Tag="H.264" Style="{DynamicResource CodecButton}"
                           GroupName="Codec" Margin="0,0,4,4"
                           IsChecked="{Binding SelectedCodec, Converter={StaticResource EnumToBool},
                                       ConverterParameter={x:Static models:VideoCodec.H264}}">
                <TextBlock Text="Universal · libx264" FontFamily="{DynamicResource MonoFont}"
                           FontSize="10" Foreground="{DynamicResource Text3Brush}" TextAlignment="Center"/>
              </RadioButton>
              <RadioButton Tag="H.265" Style="{DynamicResource CodecButton}"
                           GroupName="Codec" Margin="4,0,0,4"
                           IsChecked="{Binding SelectedCodec, Converter={StaticResource EnumToBool},
                                       ConverterParameter={x:Static models:VideoCodec.H265}}">
                <TextBlock Text="50% smaller · HEVC" FontFamily="{DynamicResource MonoFont}"
                           FontSize="10" Foreground="{DynamicResource Text3Brush}" TextAlignment="Center"/>
              </RadioButton>
              <RadioButton Tag="VP9" Style="{DynamicResource CodecButton}"
                           GroupName="Codec" Margin="0,0,4,0"
                           IsChecked="{Binding SelectedCodec, Converter={StaticResource EnumToBool},
                                       ConverterParameter={x:Static models:VideoCodec.VP9}}">
                <TextBlock Text="Open · WebM output" FontFamily="{DynamicResource MonoFont}"
                           FontSize="10" Foreground="{DynamicResource Text3Brush}" TextAlignment="Center"/>
              </RadioButton>
              <RadioButton Tag="AV1" Style="{DynamicResource CodecButton}"
                           GroupName="Codec" Margin="4,0,0,0"
                           IsChecked="{Binding SelectedCodec, Converter={StaticResource EnumToBool},
                                       ConverterParameter={x:Static models:VideoCodec.AV1}}">
                <TextBlock Text="Best ratio · slow" FontFamily="{DynamicResource MonoFont}"
                           FontSize="10" Foreground="{DynamicResource Text3Brush}" TextAlignment="Center"/>
              </RadioButton>
            </UniformGrid>

            <Separator Background="{DynamicResource Border2Brush}" Margin="0,0,0,14"/>

            <!-- Quality mode -->
            <TextBlock Text="QUALITY MODE" Style="{DynamicResource SectionLabel}"/>
            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="3" Margin="0,0,0,10">
              <UniformGrid Columns="3">
                <RadioButton Content="CRF" Style="{DynamicResource TabRadio}" GroupName="QMode"
                             IsChecked="{Binding SelectedQualityMode, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:QualityMode.CRF}}"/>
                <RadioButton Content="Bitrate" Style="{DynamicResource TabRadio}" GroupName="QMode"
                             IsChecked="{Binding SelectedQualityMode, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:QualityMode.Bitrate}}"/>
                <RadioButton Content="File size" Style="{DynamicResource TabRadio}" GroupName="QMode"
                             IsChecked="{Binding SelectedQualityMode, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:QualityMode.TargetSize}}"/>
              </UniformGrid>
            </Border>

            <!-- CRF panel -->
            <StackPanel Visibility="{Binding SelectedQualityMode, Converter={StaticResource CRFVis}}">
              <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="36"/>
                </Grid.ColumnDefinitions>
                <Slider Minimum="0" Maximum="51" Value="{Binding CrfValue}"
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Grid.Column="1" Text="{Binding CrfValue}" TextAlignment="Right"
                           FontFamily="{DynamicResource MonoFont}" FontSize="12"
                           Foreground="{DynamicResource AccentLightBrush}" VerticalAlignment="Center"/>
              </Grid>
              <Grid>
                <TextBlock Text="lossless" FontFamily="{DynamicResource MonoFont}" FontSize="9"
                           Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Left"/>
                <TextBlock Text="balanced" FontFamily="{DynamicResource MonoFont}" FontSize="9"
                           Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center"/>
                <TextBlock Text="smallest" FontFamily="{DynamicResource MonoFont}" FontSize="9"
                           Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Right"/>
              </Grid>
            </StackPanel>

            <!-- Bitrate panel -->
            <Grid Visibility="{Binding SelectedQualityMode, Converter={StaticResource BitrateVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding BitrateKbps, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Grid.Column="1" Text=" kbps" Margin="6,0,0,0" VerticalAlignment="Center"
                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         Foreground="{DynamicResource Text3Brush}"/>
            </Grid>

            <!-- Target size panel -->
            <Grid Visibility="{Binding SelectedQualityMode, Converter={StaticResource SizeVis}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox Text="{Binding TargetSizeMB, UpdateSourceTrigger=PropertyChanged}"/>
              <TextBlock Grid.Column="1" Text=" MB  (2-pass)" Margin="6,0,0,0" VerticalAlignment="Center"
                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         Foreground="{DynamicResource Text3Brush}"/>
            </Grid>

            <Separator Background="{DynamicResource Border2Brush}" Margin="0,14,0,14"/>

            <!-- Resolution -->
            <TextBlock Text="RESOLUTION" Style="{DynamicResource SectionLabel}"/>
            <Border Background="{DynamicResource Bg3Brush}" CornerRadius="8" Padding="3" Margin="0,0,0,10">
              <UniformGrid Columns="3">
                <RadioButton Content="Original" Style="{DynamicResource TabRadio}" GroupName="ResMode"
                             IsChecked="{Binding ResMode, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:ResolutionMode.Original}}"/>
                <RadioButton Content="Preset" Style="{DynamicResource TabRadio}" GroupName="ResMode"
                             IsChecked="{Binding ResMode, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:ResolutionMode.Preset}}"/>
                <RadioButton Content="Custom" Style="{DynamicResource TabRadio}" GroupName="ResMode"
                             IsChecked="{Binding ResMode, Converter={StaticResource EnumToBool},
                                         ConverterParameter={x:Static models:ResolutionMode.Custom}}"/>
              </UniformGrid>
            </Border>

            <ComboBox SelectedIndex="{Binding ResPresetIndex}"
                      Margin="0,0,0,4"
                      Visibility="{Binding ResMode, Converter={StaticResource ResPresetVis}}">
              <ComboBoxItem Content="4K (3840×2160)"/>
              <ComboBoxItem Content="1080p (1920×1080)"/>
              <ComboBoxItem Content="720p (1280×720)"/>
              <ComboBoxItem Content="480p (854×480)"/>
              <ComboBoxItem Content="360p (640×360)"/>
            </ComboBox>

            <StackPanel Visibility="{Binding ResMode, Converter={StaticResource ResCustomVis}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding CustomWidth, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Grid.Column="1" Text=" × " Margin="4,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Text3Brush}" FontSize="14"/>
                <TextBox Grid.Column="2"
                         Text="{Binding CustomHeight, UpdateSourceTrigger=PropertyChanged}"/>
              </Grid>
              <CheckBox Content="Maintain aspect ratio"
                        IsChecked="{Binding MaintainAspect}" Margin="0,6,0,0"/>
            </StackPanel>

            <Separator Background="{DynamicResource Border2Brush}" Margin="0,14,0,14"/>

            <!-- Audio -->
            <TextBlock Text="AUDIO" Style="{DynamicResource SectionLabel}"/>
            <!-- SelectedIndex bound to AudioCodecIndex: 0=AAC 1=MP3 2=Opus 3=Strip -->
            <!-- Note shown when VP9/AV1 forces Opus (WebM only supports Opus/Vorbis) -->
            <Border CornerRadius="5" Padding="8,5" Margin="0,0,0,6"
                    Background="{DynamicResource AmberBgBrush}"
                    Visibility="{Binding IsWebMCodec, Converter={StaticResource BoolToVis}}">
              <TextBlock FontFamily="{DynamicResource MonoFont}" FontSize="10"
                         Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap">
                <Run Text="VP9/AV1 → WebM container."/>
                <Run Text=" Audio forced to Opus (AAC/MP3 not supported in WebM)."/>
              </TextBlock>
            </Border>
            <ComboBox SelectedIndex="{Binding AudioCodecIndex}" Margin="0,0,0,8">
              <ComboBoxItem Content="AAC  (recommended)"/>
              <ComboBoxItem Content="MP3"/>
              <ComboBoxItem Content="Opus"/>
              <ComboBoxItem Content="Strip audio (video only)"/>
            </ComboBox>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="44"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="Bitrate" FontSize="11" Foreground="{DynamicResource Text2Brush}"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <Slider Grid.Column="1" Minimum="64" Maximum="320"
                      Value="{Binding AudioBitrateKbps}"
                      TickFrequency="64" IsSnapToTickEnabled="True"/>
              <TextBlock Grid.Column="2"
                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         Foreground="{DynamicResource AccentLightBrush}"
                         VerticalAlignment="Center" TextAlignment="Right"
                         Margin="4,0,0,0">
                <Run Text="{Binding AudioBitrateKbps}"/><Run Text="k"/>
              </TextBlock>
            </Grid>

            <Separator Background="{DynamicResource Border2Brush}" Margin="0,14,0,14"/>

            <!-- Batch options -->
            <TextBlock Text="BATCH OPTIONS" Style="{DynamicResource SectionLabel}"/>
            <CheckBox Content="Add _compressed suffix to filename"
                      IsChecked="{Binding AddSuffix}" Margin="0,0,0,7"/>
            <CheckBox Content="Open output folder when done"
                      IsChecked="{Binding AutoOpenOutput}" Margin="0,0,0,7"/>

            <Separator Background="{DynamicResource Border2Brush}" Margin="0,14,0,14"/>

            <!-- Custom FFmpeg flags -->
            <TextBlock Text="CUSTOM FFMPEG FLAGS" Style="{DynamicResource SectionLabel}"/>
            <TextBox AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap"
                     Text="{Binding CustomFlags, UpdateSourceTrigger=PropertyChanged}"
                     FontFamily="{DynamicResource MonoFont}" FontSize="11"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- Live command preview -->
            <Border Background="{DynamicResource BgBrush}" CornerRadius="6" Padding="10,9"
                    Margin="0,8,0,16" BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1">
              <TextBlock Text="{Binding CommandPreview}"
                         FontFamily="{DynamicResource MonoFont}" FontSize="10"
                         Foreground="{DynamicResource Text3Brush}"
                         TextWrapping="Wrap" LineHeight="17"/>
            </Border>

          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- ══ STATUS BAR ══ -->
    <Border Grid.Row="3" Background="{DynamicResource Bg2Brush}"
            BorderBrush="{DynamicResource Border2Brush}" BorderThickness="0,1,0,0" Padding="20,7">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left: overall status -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding OverallStatus}" FontFamily="{DynamicResource MonoFont}"
                     FontSize="11" Foreground="{DynamicResource Text2Brush}" VerticalAlignment="Center"/>
          <ProgressBar Width="120" Height="4" Margin="12,0,0,0"
                       Value="{Binding OverallProgress}"
                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Right: version + credit combined -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="{Binding AppVersion}" FontFamily="{DynamicResource MonoFont}"
                     FontSize="10" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/>
          <TextBlock Text=" — Made by Hassan Latif with " FontFamily="{DynamicResource MonoFont}"
                     FontSize="10" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/>
          <TextBlock Text="❤" FontSize="11" Foreground="#E8003D"
                     VerticalAlignment="Center" Margin="1,0"/>
          <TextBlock Text=" in Pakistan" FontFamily="{DynamicResource MonoFont}"
                     FontSize="10" Foreground="{DynamicResource Text3Brush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ══ PRESETS PANEL ══ -->
    <Grid Grid.RowSpan="4"
          Visibility="{Binding ShowPresetsPanel, Converter={StaticResource BoolToVis}}">
      <!-- Dim backdrop — click to close -->
      <Border Background="#88000000" MouseLeftButtonDown="PresetBackdrop_Click"/>
      <!-- Panel slides in from right -->
      <Border Width="380" HorizontalAlignment="Right"
              Background="{DynamicResource Bg2Brush}"
              BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1,0,0,0">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- Header -->
          <Grid Grid.Row="0" Margin="20,16,20,12">
            <TextBlock Text="Presets" FontSize="15" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" Content="✕  Close"
                    Style="{DynamicResource GhostButton}"
                    Command="{Binding TogglePresetsPanelCommand}"/>
          </Grid>

          <!-- Preset list -->
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,0,16,8">

              <!-- Built-in presets -->
              <TextBlock Text="BUILT-IN" Style="{DynamicResource SectionLabel}"
                         Margin="4,4,0,8"/>
              <ItemsControl ItemsSource="{Binding BuiltInPresets}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Margin="0,0,0,6" CornerRadius="8" Padding="14,11"
                            Background="{DynamicResource Bg3Brush}"
                            BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="PresetItem_Click">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                              <Setter Property="Background" Value="{DynamicResource AccentBgBrush}"/>
                            </Trigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextBrush}"/>
                          <TextBlock Text="{Binding Summary, Mode=OneWay}" Margin="0,3,0,0"
                                     FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                     Foreground="{DynamicResource Text3Brush}"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource Bg4Brush}"
                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                          <TextBlock Text="built-in" FontFamily="{DynamicResource MonoFont}"
                                     FontSize="9" Foreground="{DynamicResource Text3Brush}"/>
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- User presets -->
              <StackPanel Visibility="{Binding UserPresets.Count,
                          Converter={StaticResource IntToVis}}">
                <TextBlock Text="SAVED" Style="{DynamicResource SectionLabel}"
                           Margin="4,12,0,8"/>
                <ItemsControl ItemsSource="{Binding UserPresets}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,6" CornerRadius="8" Padding="14,11"
                              Background="{DynamicResource Bg3Brush}"
                              BorderThickness="1">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="{DynamicResource Border2Brush}"/>
                            <Style.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                              </Trigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0" Cursor="Hand"
                                      MouseLeftButtonUp="PresetItem_Click">
                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock Text="{Binding Summary, Mode=OneWay}" Margin="0,3,0,0"
                                       FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                       Foreground="{DynamicResource Text3Brush}"/>
                          </StackPanel>
                          <Button Grid.Column="1" Content="✕" Width="24" Height="24"
                                  FontSize="13" Background="Transparent" BorderThickness="0"
                                  Foreground="{DynamicResource Text3Brush}" Cursor="Hand"
                                  VerticalAlignment="Center"
                                  Command="{Binding DataContext.DeletePresetCommand,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

            </StackPanel>
          </ScrollViewer>

          <!-- Save new preset -->
          <Border Grid.Row="2" BorderBrush="{DynamicResource Border2Brush}"
                  BorderThickness="0,1,0,0" Padding="16,14">
            <StackPanel>
              <TextBlock Text="SAVE CURRENT SETTINGS AS PRESET"
                         Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="12" Padding="8,7"
                         KeyDown="PresetNameBox_KeyDown"/>
                <Button Grid.Column="1" Content="Save" Margin="8,0,0,0"
                        Style="{DynamicResource PrimaryButton}" Padding="14,7"
                        Command="{Binding SavePresetCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

        </Grid>
      </Border>
    </Grid>

<!-- ══ BEFORE/AFTER COMPARISON OVERLAY ══ -->
    <Border Grid.RowSpan="4" Background="#D0000000"
            Visibility="{Binding CompareFile, Converter={StaticResource NullToVisVis}}"
            MouseLeftButtonDown="CompareOverlay_Close">
      <Border MaxWidth="900" Margin="40" VerticalAlignment="Center"
              Background="{DynamicResource Bg2Brush}"
              BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
              CornerRadius="14" MouseLeftButtonDown="CompareOverlay_StopClose">
        <StackPanel Margin="28,24">

          <!-- Header -->
          <Grid Margin="0,0,0,20">
            <TextBlock Text="Before / After" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <Button HorizontalAlignment="Right" Content="✕  Close"
                    Style="{DynamicResource GhostButton}" Click="CompareClose_Click"/>
          </Grid>

          <!-- Thumbnails -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Original -->
            <StackPanel Grid.Column="0">
              <Border CornerRadius="8" ClipToBounds="True" Height="190"
                      Background="{DynamicResource Bg4Brush}">
                <Image Source="{Binding CompareFile.Thumbnail}" Stretch="UniformToFill"/>
              </Border>
              <TextBlock Text="ORIGINAL" Style="{DynamicResource SectionLabel}"
                         Margin="0,10,0,3" TextAlignment="Center"/>
              <TextBlock Text="{Binding CompareFile.OriginalSizeStr}"
                         FontFamily="{DynamicResource MonoFont}" FontSize="15" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding CompareFile.Resolution}"
                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>

            <TextBlock Grid.Column="1" Text="→" FontSize="24"
                       Foreground="{DynamicResource Text3Brush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Compressed -->
            <StackPanel Grid.Column="2">
              <Border CornerRadius="8" ClipToBounds="True" Height="190"
                      Background="{DynamicResource Bg4Brush}">
                <Grid>
                  <Image Source="{Binding CompareFile.Thumbnail}" Stretch="UniformToFill" Opacity="0.75"/>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                          Margin="0,8,8,0" CornerRadius="4" Padding="8,4"
                          Background="{DynamicResource AccentBrush}">
                    <TextBlock Text="{Binding CompareFile.SavingsText}"
                               FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               FontWeight="SemiBold" Foreground="White"/>
                  </Border>
                </Grid>
              </Border>
              <TextBlock Text="COMPRESSED" Style="{DynamicResource SectionLabel}"
                         Margin="0,10,0,3" TextAlignment="Center"/>
              <TextBlock Text="{Binding CompareFile.OutputSizeStr}"
                         FontFamily="{DynamicResource MonoFont}" FontSize="15" FontWeight="SemiBold"
                         Foreground="{Binding CompareFile.SavingsText, Converter={StaticResource SavingsColor}}"
                         HorizontalAlignment="Center"/>
              <TextBlock Text="{Binding CompareFile.Resolution}"
                         FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         Foreground="{DynamicResource Text3Brush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>
          </Grid>

          <!-- Stats bar -->
          <Border Margin="0,16,0,0" Padding="16,14"
                  Background="{DynamicResource Bg3Brush}" CornerRadius="8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <StackPanel Margin="0,0,40,0" HorizontalAlignment="Center">
                <TextBlock Text="SIZE REDUCTION" Style="{DynamicResource SectionLabel}" TextAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CompareFile.SavingsText}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{Binding CompareFile.SavingsText, Converter={StaticResource SavingsColor}}"
                           HorizontalAlignment="Center"/>
              </StackPanel>
              <StackPanel Margin="0,0,40,0">
                <TextBlock Text="ORIGINAL" Style="{DynamicResource SectionLabel}" TextAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CompareFile.OriginalSizeStr}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="COMPRESSED" Style="{DynamicResource SectionLabel}" TextAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CompareFile.OutputSizeStr}" FontSize="22" FontWeight="SemiBold"
                           Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- MediaInfo detail panel (shown when source info loaded) -->
          <Border Margin="0,12,0,0" Padding="14,12"
                  Background="{DynamicResource Bg4Brush}" CornerRadius="8"
                  Visibility="{Binding CompareFile.MediaInfoLoaded, Converter={StaticResource BoolToVis}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Left: Original file details -->
              <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="ORIGINAL" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Codec" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompareFile.VideoProfile}" Style="{DynamicResource CompareValue}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Bit Depth" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompareFile.BitDepth}" Style="{DynamicResource CompareValue}"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Chroma" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompareFile.ChromaSubsampling}" Style="{DynamicResource CompareValue}"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Color Range" Style="{DynamicResource CompareLabel}"
                             Visibility="{Binding CompareFile.ColorRange, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CompareFile.ColorRange}" Style="{DynamicResource CompareValue}"
                             Visibility="{Binding CompareFile.ColorRange, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Primaries" Style="{DynamicResource CompareLabel}"
                             Visibility="{Binding CompareFile.ColorPrimaries, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CompareFile.ColorPrimaries}" Style="{DynamicResource CompareValue}"
                             Visibility="{Binding CompareFile.ColorPrimaries, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Transfer" Style="{DynamicResource CompareLabel}"
                             Visibility="{Binding CompareFile.TransferChar, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CompareFile.TransferChar}" Style="{DynamicResource CompareValue}"
                             Visibility="{Binding CompareFile.TransferChar, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="Video Bitrate" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CompareFile.VideoBitrate}" Style="{DynamicResource CompareValue}"/>
                  <TextBlock Grid.Row="7" Grid.Column="0" Text="Encoder" Style="{DynamicResource CompareLabel}"
                             Visibility="{Binding CompareFile.WritingApp, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CompareFile.WritingApp}"
                             Visibility="{Binding CompareFile.WritingApp, Converter={StaticResource StringToVis}}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Audio tracks header -->
                <TextBlock Text="AUDIO" Style="{DynamicResource SectionLabel}" Margin="0,10,0,6"/>
                <ItemsControl ItemsSource="{Binding CompareFile.AudioTracks}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                 Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- Divider -->
              <Border Grid.Column="1" Background="{DynamicResource Border2Brush}" Width="1"/>

              <!-- Right: Compressed file details -->
              <StackPanel Grid.Column="2" Margin="12,0,0,0">
                <TextBlock Text="COMPRESSED" Style="{DynamicResource SectionLabel}" Margin="0,0,0,8"/>

                <!-- Shown when output MediaInfo is ready -->
                <Grid Visibility="{Binding CompareFile.OutputMediaInfoLoaded, Converter={StaticResource BoolToVis}}">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <TextBlock Grid.Row="0" Grid.Column="0" Text="Codec" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CompareFile.OutputMediaInfo.VideoProfileStr}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource GreenBrush}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Bit Depth" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CompareFile.OutputMediaInfo.BitDepthStr}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Chroma" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding CompareFile.OutputMediaInfo.ChromaStr}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Color Range" Style="{DynamicResource CompareLabel}"
                             Visibility="{Binding CompareFile.OutputMediaInfo.ColorRange, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding CompareFile.OutputMediaInfo.ColorRange}"
                             Visibility="{Binding CompareFile.OutputMediaInfo.ColorRange, Converter={StaticResource StringToVis}}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Grid.Row="4" Grid.Column="0" Text="Primaries" Style="{DynamicResource CompareLabel}"
                             Visibility="{Binding CompareFile.OutputMediaInfo.ColorPrimaries, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding CompareFile.OutputMediaInfo.ColorPrimaries}"
                             Visibility="{Binding CompareFile.OutputMediaInfo.ColorPrimaries, Converter={StaticResource StringToVis}}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Grid.Row="5" Grid.Column="0" Text="Transfer" Style="{DynamicResource CompareLabel}"
                             Visibility="{Binding CompareFile.OutputMediaInfo.TransferChar, Converter={StaticResource StringToVis}}"/>
                  <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CompareFile.OutputMediaInfo.TransferChar}"
                             Visibility="{Binding CompareFile.OutputMediaInfo.TransferChar, Converter={StaticResource StringToVis}}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource TextBrush}"/>
                  <TextBlock Grid.Row="6" Grid.Column="0" Text="Video Bitrate" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CompareFile.OutputMediaInfo.BitrateStr}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource GreenBrush}"/>
                  <TextBlock Grid.Row="7" Grid.Column="0" Text="Encoder" Style="{DynamicResource CompareLabel}"/>
                  <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding CompareFile.OutputMediaInfo.WritingApp}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="10"
                             Foreground="{DynamicResource GreenBrush}" TextTrimming="CharacterEllipsis"/>
                </Grid>

                <!-- Loading indicator while output is being probed -->
                <TextBlock Text="Reading compressed file…"
                           FontFamily="{DynamicResource MonoFont}" FontSize="10"
                           Foreground="{DynamicResource Text3Brush}"
                           Visibility="{Binding CompareFile.OutputMediaInfoLoaded, Converter={StaticResource InvBoolToVis}}"/>

                <!-- Audio tracks — from OUTPUT file MediaInfo -->
                <TextBlock Text="AUDIO" Style="{DynamicResource SectionLabel}" Margin="0,10,0,6"
                           Visibility="{Binding CompareFile.OutputMediaInfoLoaded, Converter={StaticResource BoolToVis}}"/>
                <ItemsControl ItemsSource="{Binding CompareFile.OutputMediaInfo.AudioTracks}"
                              Visibility="{Binding CompareFile.OutputMediaInfoLoaded, Converter={StaticResource BoolToVis}}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding Summary, Mode=OneWay}"
                                 FontFamily="{DynamicResource MonoFont}" FontSize="10"
                                 Foreground="{DynamicResource GreenBrush}" Margin="0,0,0,4"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>

        </StackPanel>
      </Border>
    </Border>

    <!-- ══ LOG OVERLAY ══ -->
    <Border Grid.RowSpan="4" Background="#C0050507"
            Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}">
      <Border Margin="40" Background="{DynamicResource Bg2Brush}"
              BorderBrush="{DynamicResource Border2Brush}" BorderThickness="1"
              CornerRadius="12">
        <Grid Margin="24">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="FFmpeg Output Log" FontSize="14" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}"/>
            <Button HorizontalAlignment="Right" Content="✕  Close"
                    Style="{DynamicResource GhostButton}"
                    Command="{Binding ToggleLogCommand}"/>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="480">
            <TextBox Text="{Binding LogText}" IsReadOnly="True"
                     Background="Transparent" BorderThickness="0"
                     FontFamily="{DynamicResource MonoFont}" FontSize="10"
                     Foreground="{DynamicResource Text2Brush}"
                     TextWrapping="Wrap" AcceptsReturn="True"/>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Clear" Style="{DynamicResource GhostButton}"
                    Click="ClearLog_Click" Margin="0,0,8,0"/>
            <Button Content="Copy all" Style="{DynamicResource GhostButton}"
                    Click="CopyLog_Click"/>
          </StackPanel>
        </Grid>
      </Border>
    </Border>

  </Grid>
</Window>
